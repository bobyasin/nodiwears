---
import { productCategories, productSeries } from '../data/products';
import { getProduct } from '../data/custom-order';
import { siteConfig } from '../data/site';
import { locales, type Locale } from '../i18n/config';
import { getHomePath, getPagePath, getSectionPath } from '../i18n/paths';
import { ui } from '../i18n/ui';
import { buildProductsQuery } from '../data/products';

interface Props {
	locale: Locale;
	alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = ui[locale];
const productsPath = getPagePath(locale, 'products');
const categories = productCategories.map((category) => ({
	id: category.id,
	label: t.nav.categories[category.id],
	href: `${productsPath}${buildProductsQuery({ category: category.id })}`,
	types: category.types.map((type) => ({
		id: type,
		label: getProduct(type)?.label[locale] ?? type,
		href: `${productsPath}${buildProductsQuery({ category: category.id, type })}`,
	})),
}));
// Special series sit after the categories and open the products page filtered to the series.
const seriesEntries = productSeries.map((series) => {
	const href = `${productsPath}${buildProductsQuery({ series: series.id })}`;

	return { id: series.id, isSeries: true, label: series.label[locale], href, types: [] as { id: string; label: string; href: string }[] };
});
const menuEntries = [...categories, ...seriesEntries];
const corporateLinks = [
	{ label: t.nav.about, href: getPagePath(locale, 'about') },
	{ label: t.nav.whoWeAre, href: getPagePath(locale, 'whoWeAre') },
	{ label: t.nav.certificates, href: getPagePath(locale, 'certificates') },
];
const switcher = locales.map((code) => ({
	code,
	label: code.toUpperCase(),
	name: t.language[code],
	href: code === locale ? undefined : alternatePath,
}));
---

<header class="site-header">
	<div class="container bar">
		<a class="brand" href={getHomePath(locale)} aria-label={t.nav.homeLabel}>
			<span class="dot" aria-hidden="true"></span>
			<span>{siteConfig.name}</span>
		</a>

		<nav id="main-nav" class="nav" aria-label={t.nav.mainMenuLabel}>
			<ul>
				<li class="has-menu" data-menu>
					<button type="button" class="menu-trigger" aria-expanded="false" aria-controls="menu-corporate">
						{t.nav.corporate}
						<span class="caret" aria-hidden="true"></span>
					</button>
					<div class="panel dropdown" id="menu-corporate">
						<ul aria-label={t.nav.corporateMenuLabel}>
							{corporateLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
						</ul>
					</div>
				</li>
				<li><a href={getSectionPath(locale, 'katalog')}>{t.nav.catalog}</a></li>
				<li class="has-menu" data-menu>
					<button type="button" class="menu-trigger" aria-expanded="false" aria-controls="menu-products">
						{t.nav.products}
						<span class="caret" aria-hidden="true"></span>
					</button>
					<div class="panel mega" id="menu-products">
						<ul class="cats" aria-label={t.nav.productsMenuLabel}>
							{
								menuEntries.map((category, index) => (
									<li class={`cat${index === 0 ? ' is-active' : ''}`}>
										<a class="cat-link" href={category.href}>{category.label}</a>
										<ul class="types">
											{category.types.map((type) => <li><a href={type.href}>{type.label}</a></li>)}
											<li class="all"><a href={category.href}>{'isSeries' in category ? t.nav.viewSeries : t.nav.allProducts}</a></li>
										</ul>
									</li>
								))
							}
						</ul>
					</div>
				</li>
				<li><a href={getSectionPath(locale, 'iletisim')}>{t.nav.contact}</a></li>
			</ul>
			<a class="button nav-cta" href={productsPath}>{t.nav.order}</a>
		</nav>

		<div class="lang" role="group" aria-label={t.language.groupLabel}>
			{
				switcher.map((item) =>
					item.href ? (
						<a href={item.href} lang={item.code} hreflang={item.code} aria-label={item.name}>
							{item.label}
						</a>
					) : (
						<span aria-current="true" aria-label={item.name}>
							{item.label}
						</span>
					),
				)
			}
		</div>

		<a class="account" href={getPagePath(locale, 'login')} aria-label={t.nav.login}>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="8" r="4"></circle>
				<path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
			</svg>
			<span class="account-label">{t.nav.login}</span>
		</a>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
			<span class="visually-hidden">{t.nav.menuToggle}</span>
			<span class="menu-icon" aria-hidden="true"></span>
		</button>
	</div>
</header>

<script>
	import { initMenus } from '../lib/header-menus';

	initMenus();

	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const nav = document.querySelector<HTMLElement>('#main-nav');

	function setMenu(open: boolean) {
		toggle?.setAttribute('aria-expanded', String(open));
		nav?.classList.toggle('is-open', open);
	}

	const header = document.querySelector<HTMLElement>('.site-header');

	function syncScrolled() {
		header?.classList.toggle('is-scrolled', window.scrollY > 8);
	}

	window.addEventListener('scroll', syncScrolled, { passive: true });
	syncScrolled();

	const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav a[href*="#"]'));
	const sections = navLinks
		.map((link) => ({ link, section: document.getElementById(link.hash.slice(1)) }))
		.filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => entry.section !== null);

	if (sections.length > 0) {
		const spy = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const match = sections.find(({ section }) => section === entry.target);

					if (match && entry.isIntersecting) {
						for (const { link } of sections) {
							link.removeAttribute('aria-current');
						}
						match.link.setAttribute('aria-current', 'true');
					} else if (match && match.link.getAttribute('aria-current') === 'true') {
						match.link.removeAttribute('aria-current');
					}
				}
			},
			{ rootMargin: '-35% 0px -55% 0px' },
		);

		for (const { section } of sections) {
			spy.observe(section);
		}
	}

	toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
	nav?.addEventListener('click', (event) => {
		if (event.target instanceof HTMLAnchorElement) {
			setMenu(false);
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid transparent;
		background: var(--color-sun-soft);
		transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
	}

	.site-header.is-scrolled {
		border-bottom-color: var(--color-line);
		box-shadow: 0 6px 24px rgb(33 26 56 / 0.06);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 68px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.dot {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--color-thread);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-thread) 18%, transparent);
		transition: transform 0.3s var(--ease);
	}

	.brand:hover .dot {
		transform: scale(1.35);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-left: auto;
	}

	.lang {
		display: flex;
		gap: 0.15rem;
		margin-left: 0.9rem;
		padding: 0.2rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 999px;
		background: var(--color-paper);
	}

	.lang a,
	.lang span {
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
	}

	.lang a {
		color: var(--color-ink-soft);
	}

	.lang a:hover {
		background: var(--color-lilac);
		color: var(--color-ink);
	}

	.lang span {
		background: var(--color-lilac-strong);
		color: var(--color-ink);
	}

	.nav > ul {
		display: flex;
		align-items: stretch;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav > ul > li {
		display: flex;
		align-items: center;
	}

	.nav > ul > li > a,
	.menu-trigger {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.9rem;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		font-weight: 500;
		text-decoration: none;
		cursor: pointer;
	}

	.caret {
		width: 0.45rem;
		height: 0.45rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		rotate: 45deg;
		translate: 0 -2px;
		transition: rotate 0.2s var(--ease);
	}

	.is-open > .menu-trigger .caret {
		rotate: 225deg;
		translate: 0 2px;
	}

	.nav > ul > li > a::after,
	.menu-trigger::after {
		position: absolute;
		right: 0.9rem;
		bottom: 0.2rem;
		left: 0.9rem;
		height: 2px;
		background: var(--color-thread);
		content: '';
		scale: 0 1;
		transform-origin: left;
		transition: scale 0.3s var(--ease);
	}

	.nav > ul > li > a:hover::after,
	.nav > ul > li > a[aria-current='true']::after,
	.menu-trigger:hover::after,
	.is-open > .menu-trigger::after {
		scale: 1 1;
	}

	.has-menu {
		position: relative;
	}

	.panel {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 20;
		border: 1px solid var(--color-line);
		border-radius: 16px;
		background: var(--color-paper);
		box-shadow: var(--shadow-lift);
	}

	.is-open > .panel {
		display: block;
	}

	:global(html:not(.js)) .has-menu:hover > .panel {
		display: block;
	}

	.dropdown {
		left: 0;
		min-width: 14rem;
		padding: 0.5rem;
	}

	.dropdown ul,
	.cats,
	.types {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.dropdown a,
	.types a,
	.cat-link {
		display: block;
		padding: 0.5rem 0.8rem;
		border-radius: 10px;
		font-weight: 600;
		text-decoration: none;
		transition: background 0.15s;
	}

	.dropdown a:hover,
	.types a:hover {
		background: var(--color-lilac);
	}

	.mega {
		width: min(34rem, 92vw);
		min-height: 15.5rem;
	}

	.cats {
		width: 11.5rem;
		padding: 0.6rem;
	}

	.cat-link {
		font-weight: 700;
	}

	.cat.is-active > .cat-link {
		background: var(--color-lilac-strong);
	}

	.types {
		display: none;
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 12rem;
		align-content: start;
		gap: 0.1rem;
		padding: 1rem 1.2rem;
		border-left: 1px solid var(--color-line);
	}

	.cat.is-active > .types {
		display: grid;
	}

	.types .all a {
		margin-top: 0.4rem;
		color: var(--color-thread-dark);
		font-weight: 700;
	}

	.account {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-left: 0.6rem;
		padding: 0.35rem 0.8rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 999px;
		background: var(--color-paper);
		font-size: 0.85rem;
		font-weight: 700;
		text-decoration: none;
		transition: background 0.15s;
	}

	.account:hover {
		background: var(--color-lilac);
	}

	.account svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.8;
	}

	.nav-cta {
		min-height: 42px;
		padding: 0.5rem 1.25rem;
		border-color: var(--color-mint-strong);
		background: var(--color-mint-strong);
		color: var(--color-ink);
		font-size: 0.95rem;
	}

	.nav-cta:hover {
		border-color: var(--color-mint-strong);
		background: var(--color-mint);
		color: var(--color-ink);
	}

	.menu-toggle {
		display: none;
		width: 44px;
		height: 44px;
		border: 1px solid var(--color-line-strong);
		border-radius: 50%;
		background: var(--color-paper);
		cursor: pointer;
	}

	.menu-icon,
	.menu-icon::before,
	.menu-icon::after {
		display: block;
		width: 18px;
		height: 2px;
		margin-inline: auto;
		background: var(--color-ink);
		content: '';
	}

	.menu-icon::before {
		transform: translateY(-6px);
	}

	.menu-icon::after {
		transform: translateY(4px);
	}

	@media (max-width: 760px) {
		.menu-toggle {
			display: block;
			margin-left: 0.5rem;
		}

		.lang {
			margin-left: auto;
		}

		.nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0.75rem;
			padding: 1rem 1.25rem 1.25rem;
			border-bottom: 1px solid var(--color-line);
			background: var(--color-sun-soft);
			box-shadow: 0 16px 28px rgb(33 26 56 / 0.1);
			/* the open menu can be taller than the screen: keep it inside and let it scroll on its own */
			max-height: calc(100vh - 4.5rem);
			max-height: calc(100dvh - 4.5rem);
			overflow-y: auto;
			overscroll-behavior: contain;
		}

		.nav.is-open {
			display: flex;
		}

		.nav > ul {
			flex-direction: column;
		}

		.nav > ul > li {
			display: block;
		}

		.menu-trigger {
			width: 100%;
			justify-content: space-between;
		}

		.panel,
		.dropdown,
		.mega {
			position: static;
			width: auto;
			min-width: 0;
			min-height: 0;
			padding: 0 0 0.4rem 0.9rem;
			border: 0;
			background: transparent;
			box-shadow: none;
		}

		.cats {
			width: auto;
			padding: 0;
		}

		.cat > .types {
			display: grid;
			position: static;
			padding: 0 0 0.4rem 0.9rem;
			border-left: 0;
		}

		.cat.is-active > .cat-link {
			background: none;
		}

		.account-label {
			display: none;
		}

		.account {
			margin-left: 0.5rem;
			padding: 0.5rem;
		}

		.nav-cta {
			text-align: center;
		}
	}
</style>
