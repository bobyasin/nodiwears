---
import { siteConfig } from '../data/site';
import { locales, type Locale } from '../i18n/config';
import { getHomePath, getSectionPath } from '../i18n/paths';
import { ui } from '../i18n/ui';

interface Props {
	locale: Locale;
	alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const t = ui[locale];
const links = [
	{ label: t.nav.catalog, href: getSectionPath(locale, 'katalog') },
	{ label: t.nav.contact, href: getSectionPath(locale, 'iletisim') },
];
const switcher = locales.map((code) => ({
	code,
	label: code.toUpperCase(),
	name: t.language[code],
	href: code === locale ? undefined : alternatePath,
}));
---

<header class="site-header">
	<div class="container bar">
		<a class="brand" href={getHomePath(locale)} aria-label={t.nav.homeLabel}>
			<span class="dot" aria-hidden="true"></span>
			<span>{siteConfig.name}</span>
		</a>

		<nav id="main-nav" class="nav" aria-label={t.nav.mainMenuLabel}>
			<ul>
				{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
			</ul>
			<a class="button nav-cta" href={getSectionPath(locale, 'iletisim')}>{t.nav.order}</a>
		</nav>

		<div class="lang" role="group" aria-label={t.language.groupLabel}>
			{
				switcher.map((item) =>
					item.href ? (
						<a href={item.href} lang={item.code} hreflang={item.code} aria-label={item.name}>
							{item.label}
						</a>
					) : (
						<span aria-current="true" aria-label={item.name}>
							{item.label}
						</span>
					),
				)
			}
		</div>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
			<span class="visually-hidden">{t.nav.menuToggle}</span>
			<span class="menu-icon" aria-hidden="true"></span>
		</button>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const nav = document.querySelector<HTMLElement>('#main-nav');

	function setMenu(open: boolean) {
		toggle?.setAttribute('aria-expanded', String(open));
		nav?.classList.toggle('is-open', open);
	}

	const header = document.querySelector<HTMLElement>('.site-header');

	function syncScrolled() {
		header?.classList.toggle('is-scrolled', window.scrollY > 8);
	}

	window.addEventListener('scroll', syncScrolled, { passive: true });
	syncScrolled();

	const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav ul a'));
	const sections = navLinks
		.map((link) => ({ link, section: document.getElementById(link.hash.slice(1)) }))
		.filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => entry.section !== null);

	if (sections.length > 0) {
		const spy = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const match = sections.find(({ section }) => section === entry.target);

					if (match && entry.isIntersecting) {
						for (const { link } of sections) {
							link.removeAttribute('aria-current');
						}
						match.link.setAttribute('aria-current', 'true');
					} else if (match && match.link.getAttribute('aria-current') === 'true') {
						match.link.removeAttribute('aria-current');
					}
				}
			},
			{ rootMargin: '-35% 0px -55% 0px' },
		);

		for (const { section } of sections) {
			spy.observe(section);
		}
	}

	toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
	nav?.addEventListener('click', (event) => {
		if (event.target instanceof HTMLAnchorElement) {
			setMenu(false);
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid transparent;
		background: color-mix(in srgb, var(--color-cream) 82%, transparent);
		backdrop-filter: blur(14px) saturate(1.3);
		transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
	}

	.site-header.is-scrolled {
		border-bottom-color: var(--color-line);
		box-shadow: 0 6px 24px rgb(33 26 56 / 0.06);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 68px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.dot {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--color-thread);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-thread) 18%, transparent);
		transition: transform 0.3s var(--ease);
	}

	.brand:hover .dot {
		transform: scale(1.35);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-left: auto;
	}

	.lang {
		display: flex;
		gap: 0.15rem;
		margin-left: 0.9rem;
		padding: 0.2rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 999px;
		background: var(--color-paper);
	}

	.lang a,
	.lang span {
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
	}

	.lang a {
		color: var(--color-ink-soft);
	}

	.lang a:hover {
		background: var(--color-lilac);
	}

	.lang span {
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.nav ul {
		display: flex;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav ul a {
		position: relative;
		display: block;
		padding: 0.45rem 0.9rem;
		font-weight: 500;
		text-decoration: none;
	}

	.nav ul a::after {
		position: absolute;
		right: 0.9rem;
		bottom: 0.2rem;
		left: 0.9rem;
		height: 2px;
		background: var(--color-thread);
		content: '';
		scale: 0 1;
		transform-origin: left;
		transition: scale 0.3s var(--ease);
	}

	.nav ul a:hover::after,
	.nav ul a[aria-current='true']::after {
		scale: 1 1;
	}

	.nav-cta {
		min-height: 42px;
		padding: 0.5rem 1.25rem;
		font-size: 0.95rem;
	}

	.menu-toggle {
		display: none;
		width: 44px;
		height: 44px;
		border: 1px solid var(--color-line-strong);
		border-radius: 50%;
		background: var(--color-paper);
		cursor: pointer;
	}

	.menu-icon,
	.menu-icon::before,
	.menu-icon::after {
		display: block;
		width: 18px;
		height: 2px;
		margin-inline: auto;
		background: var(--color-ink);
		content: '';
	}

	.menu-icon::before {
		transform: translateY(-6px);
	}

	.menu-icon::after {
		transform: translateY(4px);
	}

	@media (max-width: 760px) {
		.menu-toggle {
			display: block;
			margin-left: 0.5rem;
		}

		.lang {
			margin-left: auto;
		}

		.nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0.75rem;
			padding: 1rem 1.25rem 1.25rem;
			border-bottom: 1px solid var(--color-line);
			background: var(--color-cream);
			box-shadow: 0 16px 28px rgb(33 26 56 / 0.1);
		}

		.nav.is-open {
			display: flex;
		}

		.nav ul {
			flex-direction: column;
		}

		.nav-cta {
			text-align: center;
		}
	}
</style>
