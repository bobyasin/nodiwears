---
import { catalogTree } from '../data/site';
import type { Locale } from '../i18n/config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const titles = catalogTree.map((collection) => collection.title[locale]);
// Each half must be wider than any viewport, otherwise a gap shows up while looping.
const HALF_REPEATS = 8;
const items = Array.from({ length: HALF_REPEATS }, () => titles).flat();
const halves = [0, 1];
---

<div class="marquee" aria-hidden="true">
	<div class="track">
		{
			halves.map(() => (
				<ul>
					{items.map((title) => (
						<li>{title}</li>
					))}
				</ul>
			))
		}
	</div>
</div>

<style>
	.marquee {
		overflow: hidden;
		width: calc(100% + 4rem);
		margin-inline: -2rem;
		border-block: 3px solid var(--color-ink);
		background: var(--color-sun);
		transform: rotate(-1deg);
	}

	.track {
		display: flex;
		width: max-content;
		animation: slide 60s linear infinite;
	}

	.marquee:hover .track {
		animation-play-state: paused;
	}

	ul {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		padding: 0.7rem 0;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		white-space: nowrap;
	}

	li::after {
		content: '✦';
		padding-inline: 1.5rem;
		color: var(--color-thread);
	}

	@keyframes slide {
		to {
			transform: translateX(-50%);
		}
	}
</style>
