---
import ProductSprite from './ProductSprite.astro';
import { getPolicyById } from '../data/policies';
import { ONE_SIZE, colors, presetLabels, printSpecs, products } from '../data/custom-order';
import { siteConfig } from '../data/site';
import type { Locale } from '../i18n/config';
import { getHomePath, getPolicyPath } from '../i18n/paths';
import { ui } from '../i18n/ui';
import { formatMessage } from '../lib/format';
import {
	IMAGE_MAX_BYTES,
	IMAGE_MAX_SIDE,
	IMAGE_MIN_SIDE,
	IMAGE_TYPES,
	MAX_NAME_LENGTH,
	MAX_NOTE_LENGTH,
	ORDER_STEPS,
	PRINT_MIN_CM,
} from '../lib/custom-order';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].customDesign;
const kvkk = getPolicyById(locale, 'kvkk');
const limits = {
	maxMb: IMAGE_MAX_BYTES / (1024 * 1024),
	min: IMAGE_MIN_SIDE,
	max: IMAGE_MAX_SIDE,
	maxName: MAX_NAME_LENGTH,
	maxNote: MAX_NOTE_LENGTH,
};
const stepLabels = [t.step1Label, t.step2Label, t.step3Label, t.step4Label];
const live = siteConfig.customOrderEndpoint !== '';
const sizeLabel = (size: string) => (size === ONE_SIZE ? t.oneSize : size);
const sizes = [...new Set(products.flatMap((product) => product.sizes))].map((size) => ({
	id: size,
	label: sizeLabel(size),
	for: products.filter((product) => product.sizes.includes(size)).map((product) => product.id),
}));
const consentParts = t.consentLabel.split('{link}');
const copy = {
	errors: Object.fromEntries(
		Object.entries(t.errors).map(([key, message]) => [key, formatMessage(message, limits)]),
	),
	imageInfo: t.imageInfo,
	uploadLabel: t.uploadLabel,
	uploadChange: t.uploadChange,
	submitFailed: t.submitFailed,
	submitting: t.submitting,
	submit: t.submit,
	soonNote: t.soonNote,
	printMax: t.printMax,
	printCustom: t.printCustom,
	printCustomHint: t.printCustomHint,
	placementCustom: t.placementCustom,
};
const labels = {
	presets: Object.fromEntries(
		Object.entries(presetLabels).map(([id, text]) => [id, { label: text.label[locale], hint: text.hint[locale] }]),
	),
	positions: Object.fromEntries(
		Object.entries(printSpecs).map(([id, spec]) => [
			id,
			Object.fromEntries(spec.positions.map((position) => [position.id, position.label[locale]])),
		]),
	),
};
---

<section class="section custom" id="ozel-tasarim">
	<div class="container">
		<a class="back" href={getHomePath(locale)}>{t.back}</a>
		<p class="eyebrow">{t.eyebrow}</p>
		<h1 class="section-title">{t.title}</h1>
		<p class="section-lead">{t.lead}</p>

		<ProductSprite />

		<ol class="stepper" aria-label={t.stepsLabel}>
			{
				stepLabels.map((label, index) => (
					<li data-stepper={index}>
						<button type="button" class="stepper-button" data-goto={index} disabled={index > 0}>
							<span class="num">{String(index + 1).padStart(2, '0')}</span>
							<span class="stepper-label">{label}</span>
						</button>
					</li>
				))
			}
		</ol>

		<form
			id="custom-order"
			class="wizard"
			novalidate
			data-locale={locale}
			data-endpoint={siteConfig.customOrderEndpoint}
			data-steps={JSON.stringify(ORDER_STEPS)}
			data-copy={JSON.stringify(copy)}
			data-labels={JSON.stringify(labels)}
			data-accept={IMAGE_TYPES.join(',')}
		>
			<p class="step-count" id="step-count" aria-live="polite"></p>

			<section class="panel" data-panel="product" aria-labelledby="title-product">
				<h2 id="title-product" tabindex="-1">{t.step1Title}</h2>
				<p class="hint">{t.step1Hint}</p>
				<fieldset>
					<legend class="visually-hidden">{t.productsLegend}</legend>
					<div class="products">
						{
							products.map((product) => (
								<label class="card">
									<input
										type="radio"
										name="product"
										value={product.id}
										data-label={product.label[locale]}
										class="visually-hidden"
									/>
									<svg viewBox="0 0 200 200" aria-hidden="true">
										<use href={`#shape-${product.id}`}></use>
									</svg>
									<span>{product.label[locale]}</span>
								</label>
							))
						}
					</div>
				</fieldset>
			</section>

			<section class="panel" data-panel="options" aria-labelledby="title-options" hidden>
				<h2 id="title-options" tabindex="-1">{t.step2Title}</h2>
				<fieldset>
					<legend>{t.colorLegend}</legend>
					<div class="swatches">
						{
							colors.map((color) => (
								<label class="swatch">
									<input
										type="radio"
										name="color"
										value={color.id}
										data-label={color.name[locale]}
										class="visually-hidden"
									/>
									<span class="chip" style={`--chip:${color.hex}`}></span>
									<span>{color.name[locale]}</span>
								</label>
							))
						}
					</div>
				</fieldset>
				<fieldset>
					<legend>{t.sizeLegend}</legend>
					<div class="sizes">
						{
							sizes.map((size) => (
								<label class="size" data-for={size.for.join(' ')} hidden>
									<input type="radio" name="size" value={size.id} data-label={size.label} class="visually-hidden" />
									<span>{size.label}</span>
								</label>
							))
						}
					</div>
				</fieldset>
				<fieldset>
					<legend>{t.printLegend}</legend>
					<p class="hint" id="print-max"></p>
					<div class="prints" id="print-presets"></div>
					<div class="print-custom" id="print-custom" hidden>
						<label>
							{t.widthField}
							<input type="number" name="printWidth" inputmode="decimal" min={PRINT_MIN_CM} step="0.5" />
						</label>
						<label>
							{t.heightField}
							<input type="number" name="printHeight" inputmode="decimal" min={PRINT_MIN_CM} step="0.5" />
						</label>
					</div>
				</fieldset>
				<fieldset>
					<legend>{t.placementLegend}</legend>
					<p class="hint">{t.placementHint}</p>
					<div class="placement">
						<div class="placer" id="placer" tabindex="0" role="group" aria-label={t.placementPicture}>
							<svg viewBox="0 0 200 200" aria-hidden="true">
								<use id="placer-shape" href="#shape-tshirt"></use>
							</svg>
							<div class="zone" id="placer-zone"></div>
							<div class="box" id="placer-box"><span id="placer-dim"></span></div>
						</div>
						<div class="spots-wrap">
							<div class="prints prints--spots" id="placement-presets" role="radiogroup" aria-label={t.placementLegend}></div>
							<p class="current" id="placement-current" aria-live="polite"></p>
						</div>
					</div>
				</fieldset>
			</section>

			<section class="panel" data-panel="upload" aria-labelledby="title-upload" hidden>
				<h2 id="title-upload" tabindex="-1">{t.step3Title}</h2>

				<label class="consent">
					<input type="checkbox" name="consent" id="consent" />
					<span>
						{consentParts[0]}
						{kvkk ? <a href={getPolicyPath(locale, kvkk.slug)} target="_blank" rel="noopener">{t.consentLink}</a> : t.consentLink}
						{consentParts[1]}
					</span>
				</label>

				<div class="rules">
					<h3>{t.rulesTitle}</h3>
					<ul>
						<li>{t.ruleFormat}</li>
						<li>{formatMessage(t.ruleSize, limits)}</li>
						<li>{formatMessage(t.ruleMinSide, limits)}</li>
						<li>{formatMessage(t.ruleMaxSide, limits)}</li>
						<li>{t.ruleRights}</li>
					</ul>
				</div>

				<div class="upload">
					<input
						id="image"
						class="visually-hidden"
						type="file"
						name="image"
						accept={IMAGE_TYPES.join(',')}
						disabled
					/>
					<label class="button button--ghost upload-button" for="image" id="upload-button">{t.uploadLabel}</label>
					<p class="hint" id="upload-locked">{t.uploadLocked}</p>
					<div class="picked" id="picked" hidden>
						<img id="thumb" alt={t.imageAlt} width="96" height="96" />
						<p id="image-info"></p>
						<button type="button" class="link-button" id="remove-image">{t.uploadRemove}</button>
					</div>
				</div>
			</section>

			<section class="panel" data-panel="review" aria-labelledby="title-review" hidden>
				<h2 id="title-review" tabindex="-1">{t.step4Title}</h2>

				<div class="review">
					<figure class="mockup" id="mockup">
						<div class="stage">
							<svg viewBox="0 0 200 200" role="img" aria-label={t.previewAlt}>
								<use id="mockup-shape" href="#shape-tshirt"></use>
							</svg>
							<img id="mockup-design" alt="" hidden />
						</div>
						<figcaption>{t.previewNote}</figcaption>
					</figure>

					<div class="details">
						<h3>{t.summaryTitle}</h3>
						<dl class="summary">
							<dt>{t.summaryProduct}</dt>
							<dd id="sum-product"></dd>
							<dt>{t.summaryColor}</dt>
							<dd id="sum-color"></dd>
							<dt>{t.summarySize}</dt>
							<dd id="sum-size"></dd>
							<dt>{t.summaryPrint}</dt>
							<dd id="sum-print"></dd>
							<dt>{t.summaryPlacement}</dt>
							<dd id="sum-placement"></dd>
							<dt>{t.summaryImage}</dt>
							<dd id="sum-image"></dd>
						</dl>

						<label>
							{t.noteLabel}
							<textarea name="note" rows="4" maxlength={MAX_NOTE_LENGTH} placeholder={t.notePlaceholder}></textarea>
						</label>
						<label>
							{t.nameField}
							<input type="text" name="name" autocomplete="name" maxlength={MAX_NAME_LENGTH} required />
						</label>
						<label>
							{t.emailField}
							<input type="email" name="email" autocomplete="email" required />
						</label>
						<p class="hint">{t.contactNote}</p>
						{!live && <p class="soon" id="soon-note">{t.soonNote}</p>}
					</div>
				</div>
			</section>

			<section class="panel success" data-panel="success" aria-labelledby="title-success" hidden>
				<h2 id="title-success" tabindex="-1">{t.successTitle}</h2>
				<p>{t.successText}</p>
				<button type="button" class="button button--ghost" id="again">{t.again}</button>
			</section>

			<p class="form-status" id="order-status" role="alert" aria-live="polite"></p>

			<div class="actions" id="actions">
				<button type="button" class="button button--ghost" id="previous" hidden>{t.previous}</button>
				<button type="button" class="button" id="next">{t.next}</button>
				<button type="submit" class="button" id="submit" hidden disabled={!live}>
					{live ? t.submit : t.submitSoon}
				</button>
			</div>
		</form>
	</div>
</section>

<script>
	import { startWizard } from '../lib/custom-order-wizard';

	const form = document.querySelector<HTMLFormElement>('#custom-order');

	if (form) {
		startWizard(form);
	}
</script>

<style>
	.back {
		display: inline-block;
		margin-bottom: 1.5rem;
		padding: 0.35rem 1rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 999px;
		background: var(--color-paper);
		font-weight: 700;
		text-decoration: none;
		transition: background 0.15s;
	}

	.back:hover {
		background: var(--color-lilac);
	}

	.stepper {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 2.25rem 0 1.5rem;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 700px) {
		.stepper::before {
			position: absolute;
			top: 1.45rem;
			right: 12%;
			left: 12%;
			border-top: 2px dashed var(--color-line-strong);
			content: '';
		}
	}

	.stepper-button {
		position: relative;
		display: grid;
		justify-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-ink-soft);
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		text-align: center;
		cursor: pointer;
	}

	.stepper-button:disabled {
		cursor: default;
		opacity: 0.55;
	}

	.num {
		display: grid;
		place-items: center;
		width: 2.9rem;
		height: 2.9rem;
		border: 1px solid var(--color-ink);
		border-radius: 50%;
		background: var(--color-cream);
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 600;
		transition: background 0.3s, color 0.3s;
	}

	.stepper-button[aria-current='step'] .num {
		border-color: var(--color-lilac-strong);
		background: var(--color-lilac-strong);
	}

	.stepper-button[aria-current='step'] {
		color: var(--color-ink);
	}

	.is-done .num {
		border-color: var(--color-mint-strong);
		background: var(--color-mint-strong);
	}

	@media (max-width: 699px) {
		.stepper-label {
			display: none;
		}

		.stepper-button[aria-current='step'] .stepper-label {
			display: block;
		}

		.stepper {
			grid-template-columns: repeat(4, auto);
			justify-content: start;
			gap: 1.1rem;
		}
	}

	.wizard {
		display: grid;
		gap: 1.25rem;
		padding: clamp(1.25rem, 4vw, 2.25rem);
		border: 1px solid var(--color-line);
		border-radius: 20px;
		background: var(--color-paper);
		box-shadow: var(--shadow);
	}

	.step-count {
		margin: 0;
		color: var(--color-ink-soft);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	h2 {
		margin: 0;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
	}

	h2:focus {
		outline: none;
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
	}

	.panel {
		display: grid;
		gap: 1.25rem;
	}

	.panel[hidden] {
		display: none;
	}

	.hint {
		margin: 0;
		color: var(--color-ink-soft);
		font-size: 0.9rem;
	}

	fieldset {
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	legend {
		margin-bottom: 0.6rem;
		padding: 0;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.products {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(116px, 1fr));
		gap: 0.75rem;
	}

	.card,
	.swatch,
	.size,
	:global(.print-option) {
		cursor: pointer;
	}

	.card {
		display: grid;
		justify-items: center;
		gap: 0.4rem;
		padding: 0.9rem 0.5rem 0.75rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 14px;
		background: var(--color-cream);
		font-weight: 600;
		transition: border-color 0.15s, background 0.15s, transform 0.2s var(--ease);
	}

	.card svg {
		width: 64px;
		height: 64px;
		fill: var(--color-lilac);
		stroke: var(--color-ink-soft);
		stroke-width: 1.5;
	}

	.card:hover {
		transform: translateY(-2px);
	}

	.card:has(input:checked),
	.size:has(input:checked),
	:global(.print-option):has(input:checked) {
		border-color: var(--color-lilac-strong);
		background: var(--color-lilac-strong);
	}

	.card:has(input:checked) svg {
		fill: var(--color-paper);
	}

	.card:has(input:focus-visible),
	.swatch:has(input:focus-visible),
	.size:has(input:focus-visible),
	:global(.print-option):has(input:focus-visible) {
		outline: 3px solid var(--color-thread);
		outline-offset: 3px;
	}

	.swatches {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.9rem;
	}

	.swatch {
		display: grid;
		justify-items: center;
		gap: 0.3rem;
		width: 4.2rem;
		font-size: 0.78rem;
		font-weight: 600;
		text-align: center;
	}

	.chip {
		width: 2.6rem;
		height: 2.6rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 50%;
		background: var(--chip);
		box-shadow: 0 0 0 3px var(--color-paper);
		transition: box-shadow 0.15s;
	}

	.swatch:has(input:checked) .chip {
		box-shadow: 0 0 0 3px var(--color-paper), 0 0 0 5px var(--color-ink);
	}

	.sizes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.size {
		min-width: 3.2rem;
		padding: 0.5rem 0.9rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 999px;
		background: var(--color-cream);
		font-weight: 700;
		text-align: center;
	}

	.size[hidden] {
		display: none;
	}

	.prints {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 0.6rem;
		margin-top: 0.6rem;
	}

	.placement {
		display: grid;
		grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
		margin-top: 0.6rem;
	}

	.placer {
		position: relative;
		aspect-ratio: 1;
		border: 1px solid var(--color-line-strong);
		border-radius: 18px;
		background: var(--color-cream);
		--garment: #ffffff;
		cursor: crosshair;
		touch-action: manipulation;
	}

	.placer svg {
		display: block;
		width: 100%;
		height: 100%;
		fill: var(--garment);
		stroke: rgb(33 26 56 / 0.35);
		stroke-width: 1.5;
		pointer-events: none;
	}

	.zone,
	.box {
		position: absolute;
		pointer-events: none;
	}

	.zone {
		border: 1.5px dashed rgb(33 26 56 / 0.4);
		border-radius: 8px;
	}

	.box {
		display: grid;
		place-items: center;
		border: 2px solid var(--color-thread);
		border-radius: 4px;
		background: rgb(201 57 27 / 0.14);
		transition: left 0.15s var(--ease), top 0.15s var(--ease), width 0.15s var(--ease), height 0.15s var(--ease);
	}

	.box span {
		padding: 0.05rem 0.3rem;
		border-radius: 4px;
		background: var(--color-paper);
		font-size: 0.68rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.prints--spots {
		grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
		margin-top: 0;
	}

	.current {
		margin: 0.7rem 0 0;
		color: var(--color-ink-soft);
		font-size: 0.9rem;
		font-weight: 600;
	}

	:global(.print-option) {
		display: grid;
		gap: 0.1rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 14px;
		background: var(--color-cream);
		transition: border-color 0.15s, background 0.15s;
	}

	:global(.print-name) {
		font-weight: 700;
	}

	:global(.print-dim) {
		font-family: var(--font-display);
		font-size: 1.05rem;
	}

	:global(.print-hint) {
		color: var(--color-ink-soft);
		font-size: 0.78rem;
	}

	.print-custom {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 12rem));
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.print-custom[hidden] {
		display: none;
	}

	.consent {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--color-lilac-strong);
		border-radius: 14px;
		background: var(--color-lilac);
		font-weight: 600;
		cursor: pointer;
	}

	.consent input {
		flex: none;
		width: 1.2rem;
		height: 1.2rem;
		margin-top: 0.2rem;
		accent-color: var(--color-ink);
	}

	.rules ul {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-ink-soft);
		font-size: 0.92rem;
	}

	.upload {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
	}

	.upload-button.is-locked {
		opacity: 0.5;
		pointer-events: none;
	}

	.upload:has(input:focus-visible) .upload-button {
		outline: 3px solid var(--color-thread);
		outline-offset: 3px;
	}

	.picked {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.picked[hidden] {
		display: none;
	}

	.picked img {
		width: 96px;
		height: 96px;
		border: 1px solid var(--color-line-strong);
		border-radius: 12px;
		background: var(--color-cream);
		object-fit: contain;
	}

	.picked p {
		margin: 0;
		font-size: 0.9rem;
		word-break: break-word;
	}

	.link-button {
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-thread-dark);
		font: inherit;
		font-weight: 700;
