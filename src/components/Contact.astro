---
import { siteConfig } from '../data/site';
import type { Locale } from '../i18n/config';
import { getPolicyPath } from '../i18n/paths';
import { getPolicyById } from '../data/policies';
import { ui } from '../i18n/ui';
import { MAX_MESSAGE_LENGTH, MAX_NAME_LENGTH } from '../lib/contact';

interface Props {
	locale: Locale;
	defaultMessage?: string;
}

const { locale, defaultMessage = '' } = Astro.props;
const t = ui[locale].contact;
const kvkk = getPolicyById(locale, 'kvkk');
const mailCopy = { subject: t.mailSubject, nameLabel: t.mailNameLabel, emailLabel: t.mailEmailLabel };
---

<section class="section contact" id="iletisim">
	<div class="container layout">
		<div>
			<h2 class="section-title">{t.title}</h2>
			<ul class="info">
				<li><strong>{t.email}</strong> <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></li>
				<li><strong>{t.phone}</strong> {siteConfig.contactPhone}</li>
			</ul>
		</div>

		<form
			id="contact-form"
			novalidate
			data-recipient={siteConfig.contactEmail}
			data-errors={JSON.stringify(t.errors)}
			data-mail={JSON.stringify(mailCopy)}
		>
			<label>
				{t.nameField}
				<input type="text" name="name" autocomplete="name" maxlength={MAX_NAME_LENGTH} required />
			</label>
			<label>
				{t.emailField}
				<input type="email" name="email" autocomplete="email" required />
			</label>
			<label>
				{t.messageField}
				<textarea id="message" name="message" rows="5" maxlength={MAX_MESSAGE_LENGTH} required>{defaultMessage}</textarea>
			</label>
			<p class="form-status" id="form-status" role="alert" aria-live="polite"></p>
			<button class="button" type="submit">{t.submit}</button>
			<p class="note">
				{t.note}
				{kvkk && <a href={getPolicyPath(locale, kvkk.slug)}>{t.noteLink}</a>}
			</p>
		</form>
	</div>
</section>

<script>
	import { formatMessage } from '../lib/format';
	import { MAX_MESSAGE_LENGTH, MAX_NAME_LENGTH, buildMailtoUrl, validateContact } from '../lib/contact';
	import type { ContactError, MailCopy } from '../lib/contact';

	const form = document.querySelector<HTMLFormElement>('#contact-form');
	const status = document.querySelector<HTMLElement>('#form-status');

	function readJson<T>(value: string | undefined, fallback: T): T {
		try {
			return value ? (JSON.parse(value) as T) : fallback;
		} catch {
			return fallback;
		}
	}

	form?.addEventListener('submit', (event) => {
		event.preventDefault();

		const messages = readJson<Record<ContactError, string>>(form.dataset.errors, {} as Record<ContactError, string>);
		const mailCopy = readJson<MailCopy>(form.dataset.mail, { subject: '', nameLabel: '', emailLabel: '' });
		const data = new FormData(form);
		const input = {
			name: String(data.get('name') ?? ''),
			email: String(data.get('email') ?? ''),
			message: String(data.get('message') ?? ''),
		};
		const errors = validateContact(input);
		const maxByError: Partial<Record<ContactError, number>> = {
			'name-too-long': MAX_NAME_LENGTH,
			'message-too-long': MAX_MESSAGE_LENGTH,
		};

		if (status) {
			status.textContent = errors
				.map((error) => formatMessage(messages[error] ?? error, { max: maxByError[error] ?? 0 }))
				.join(' ');
		}

		if (errors.length > 0) {
			return;
		}

		window.location.href = buildMailtoUrl(form.dataset.recipient ?? '', input, mailCopy);
	});
</script>

<style>
	.contact {
		margin-top: 2rem;
		border-block: 3px solid var(--color-ink);
		background: var(--color-mint);
	}

	.layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.info {
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--color-ink-soft);
	}

	.info li {
		margin-bottom: 0.4rem;
	}

	form {
		display: grid;
		gap: 1rem;
		padding: 1.75rem;
		border: 3px solid var(--color-ink);
		border-radius: var(--radius);
		background: var(--color-paper);
		box-shadow: var(--shadow);
	}

	label {
		display: grid;
		gap: 0.35rem;
		font-weight: 600;
	}

	input,
	textarea {
		padding: 0.75rem 0.9rem;
		border: 2px solid var(--color-ink);
		border-radius: 12px;
		background: var(--color-cream);
		color: var(--color-ink);
		font: inherit;
	}

	input:focus,
	textarea:focus {
		background: #fff;
		box-shadow: 3px 3px 0 var(--color-thread);
		outline: none;
	}

	.note {
		margin: 0;
		color: var(--color-ink-soft);
		font-size: 0.85rem;
	}

	.form-status {
		min-height: 1.4em;
		margin: 0;
		color: var(--color-thread-dark);
		font-weight: 600;
	}

	@media (max-width: 820px) {
		.layout {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
