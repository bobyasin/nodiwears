---
import { catalogTree, collectDesigns } from '../data/site';
import type { Locale } from '../i18n/config';
import { getDesignPath } from '../i18n/paths';
import { ui } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].catalog;
const designs = collectDesigns(catalogTree, locale);
const COLOR_COUNT = 4;
const colorByCollection = new Map(catalogTree.map((collection, index) => [collection.id, index % COLOR_COUNT]));
---

<section class="section" id="katalog">
	<div class="container">
		<h2 class="section-title" data-reveal>{t.title}</h2>

		<div class="filters" role="group" aria-label={t.filterLabel}>
			<button type="button" data-filter="all" aria-pressed="true">{t.all}</button>
			{
				catalogTree.map((collection) => (
					<button type="button" data-filter={collection.id} aria-pressed="false">
						{collection.title[locale]}
					</button>
				))
			}
		</div>

		<ul class="grid">
			{
				designs.map(({ node, title, collection, rootId }, index) => (
					<li data-root={rootId} data-color={colorByCollection.get(rootId)} data-reveal style={`--i:${index % 6}`}>
						<a class="card" href={getDesignPath(locale, node.id)}>
							<span class="label">
								<span>{collection}</span>
								<span class="go" aria-hidden="true">↗</span>
							</span>
							<span class="name">{title}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	import { ALL_FILTER, matchesFilter } from '../lib/catalog-filter';

	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('#katalog [data-filter]'));
	const items = Array.from(document.querySelectorAll<HTMLElement>('#katalog [data-root]'));

	function applyFilter(filter: string) {
		for (const button of buttons) {
			button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
		}

		for (const item of items) {
			item.hidden = !matchesFilter(filter, item.dataset.root ?? '');
		}
	}

	for (const button of buttons) {
		button.addEventListener('click', () => applyFilter(button.dataset.filter ?? ALL_FILTER));
	}
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.75rem 0;
	}

	.filters button {
		padding: 0.5rem 1.2rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 999px;
		background: var(--color-paper);
		color: var(--color-ink);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s var(--ease);
	}

	.filters button:hover {
		border-color: var(--color-ink);
		transform: translateY(-1px);
	}

	.filters button[aria-pressed='true'] {
		border-color: var(--color-ink);
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));
		gap: 1.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.grid li[hidden] {
		display: none;
	}

	.grid li[data-color='0'] {
		--card: var(--color-lilac);
	}

	.grid li[data-color='1'] {
		--card: var(--color-mint);
	}

	.grid li[data-color='2'] {
		--card: var(--color-pink);
	}

	.grid li[data-color='3'] {
		--card: #f8ebc6;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.5rem;
		aspect-ratio: 1;
		padding: 1.1rem 1.2rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
		border-radius: var(--radius);
		background: var(--card, var(--color-paper));
		text-decoration: none;
		transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s;
	}

	/* an embroidery stitch line that sews itself across the card on hover */
	.card::after {
		position: absolute;
		right: 1.2rem;
		bottom: 0.9rem;
		left: 1.2rem;
		height: 0;
		border-top: 2px dashed var(--color-thread);
		content: '';
		clip-path: inset(0 100% 0 0);
		transition: clip-path 0.5s var(--ease);
	}

	.card:hover {
		transform: translateY(-5px);
		border-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
		box-shadow: var(--shadow-lift);
	}

	.card:hover::after,
	.card:focus-visible::after {
		clip-path: inset(0 0 0 0);
	}

	.label {
		position: relative;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		color: var(--color-ink-soft);
		font-size: 0.74rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.go {
		display: grid;
		flex: none;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--color-paper);
		color: var(--color-ink);
		font-size: 1rem;
		letter-spacing: 0;
		transition: transform 0.3s var(--ease), background 0.3s, color 0.3s;
	}

	.card:hover .go {
		background: var(--color-thread);
		color: var(--color-paper);
		transform: rotate(45deg);
	}

	.name {
		position: relative;
		margin-bottom: 0.9rem;
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.1;
		hyphens: auto;
		overflow-wrap: anywhere;
	}

	@media (max-width: 520px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}

		.card {
			padding: 0.9rem;
		}

		.name {
			font-size: 1.2rem;
		}

		.label {
			font-size: 0.68rem;
		}
	}
</style>
