---
import { getPolicies } from '../data/policies';
import { siteConfig } from '../data/site';
import type { Locale } from '../i18n/config';
import { getCustomDesignPath, getPagePath, getPolicyPath, getSectionPath } from '../i18n/paths';
import { ui } from '../i18n/ui';
import { formatMessage } from '../lib/format';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const links = [
	{ label: t.nav.products, href: getPagePath(locale, 'products') },
	{ label: t.nav.catalog, href: getSectionPath(locale, 'katalog') },
	{ label: t.nav.custom, href: getCustomDesignPath(locale) },
	{ label: t.nav.about, href: getPagePath(locale, 'about') },
	{ label: t.nav.whoWeAre, href: getPagePath(locale, 'whoWeAre') },
	{ label: t.nav.certificates, href: getPagePath(locale, 'certificates') },
	{ label: t.nav.contact, href: getPagePath(locale, 'contact') },
];
const rights = formatMessage(t.footer.rights, { year: new Date().getFullYear(), name: siteConfig.name });
---

<footer class="footer">
	<div class="container">
		<p class="wordmark" aria-hidden="true">{siteConfig.name}</p>

		<div class="columns">
			<div>
				<p class="tagline">{t.footer.tagline}</p>
			</div>
			<nav aria-label={t.footer.menuLabel}>
				<h2>{t.footer.menuLabel}</h2>
				<ul>
					{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</nav>
			<nav aria-label={t.footer.policiesLabel}>
				<h2>{t.footer.policiesLabel}</h2>
				<ul>
					{getPolicies(locale).map((policy) => <li><a href={getPolicyPath(locale, policy.slug)}>{policy.title}</a></li>)}
				</ul>
			</nav>
			<div>
				<h2>{t.footer.contactLabel}</h2>
				<ul>
					<li><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></li>
				</ul>
			</div>
		</div>

		<p class="copy">{rights}</p>
	</div>
</footer>

<style>
	.footer {
		padding-block: 3rem 2rem;
		border-top: 0;
		background: var(--color-ink);
		color: var(--color-cream);
		font-size: 0.95rem;
	}

	.wordmark {
		margin: 0 0 2rem;
		color: var(--color-sun);
		font-family: var(--font-display);
		font-size: clamp(3rem, 14vw, 9rem);
		font-weight: 600;		letter-spacing: -0.05em;
		line-height: 0.9;
	}

	.columns {
		display: grid;
		grid-template-columns: 1.4fr repeat(3, 1fr);
		gap: 2rem;
		padding-block: 1.75rem;
		border-block: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
	}

	h2 {
		margin: 0 0 0.75rem;
		color: var(--color-lilac);
		font-family: var(--font-body);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.tagline {
		max-width: 22ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;		line-height: 1.2;
	}

	ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.copy {
		margin: 1.5rem 0 0;
		color: var(--color-lilac);
		font-size: 0.88rem;
	}

	a {
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	a:hover {
		color: var(--color-sun);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	a:focus-visible {
		outline-color: var(--color-sun);
	}

	@media (max-width: 820px) {
		.columns {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 480px) {
		.columns {
			grid-template-columns: 1fr;
		}
	}
</style>
