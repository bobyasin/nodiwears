---
import { getPolicyById } from '../data/policies';
import type { Locale } from '../i18n/config';
import { getPolicyPath } from '../i18n/paths';
import { ui } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].cookie;
const cookiePolicy = getPolicyById(locale, 'cookies');
---

<aside id="cookie-banner" class="banner" role="region" aria-label={t.label} hidden>
	<p>
		{t.text}{' '}
		{cookiePolicy && <a href={getPolicyPath(locale, cookiePolicy.slug)}>{t.policyLink}</a>}
	</p>
	<button class="button" type="button" id="cookie-banner-close">{t.ok}</button>
</aside>

<script>
	import { acknowledgeNotice, hasAcknowledgedNotice } from '../lib/cookie-consent';

	const banner = document.querySelector<HTMLElement>('#cookie-banner');
	const closeButton = document.querySelector<HTMLButtonElement>('#cookie-banner-close');
	let storage: Storage | null = null;

	try {
		storage = window.localStorage;
	} catch {
		// Storage is blocked: the notice is shown on every visit and the choice is not remembered.
		storage = null;
	}

	if (banner && !(storage && hasAcknowledgedNotice(storage))) {
		banner.hidden = false;
	}

	closeButton?.addEventListener('click', () => {
		if (storage) {
			acknowledgeNotice(storage);
		}

		if (banner) {
			banner.hidden = true;
		}
	});
</script>

<style>
	.banner {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		left: 1rem;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 560px;
		padding: 0.9rem 1rem 0.9rem 1.25rem;
		border: 1px solid var(--color-line-strong);
		border-radius: var(--radius);
		background: var(--color-paper);
		box-shadow: var(--shadow);
	}

	.banner[hidden] {
		display: none;
	}

	p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.45;
	}

	a {
		font-weight: 700;
		white-space: nowrap;
	}

	.button {
		flex: none;
		padding: 0.5rem 1.2rem;
		box-shadow: none;
	}

	@media (max-width: 480px) {
		.banner {
			flex-direction: column;
			align-items: stretch;
			text-align: left;
		}
	}
</style>
