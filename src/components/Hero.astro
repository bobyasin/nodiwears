---
import { Image } from 'astro:assets';
import heroLogo from '../assets/nodiwears.jpeg';
import type { Locale } from '../i18n/config';
import { getCustomDesignPath, getSectionPath } from '../i18n/paths';
import { ui } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].hero;
---

<section class="hero" id="top">
	<div class="container grid">
		<div class="copy">
			<p class="eyebrow">{t.eyebrow}</p>
			<h1>
				{t.titleLine}<br />
				<mark>{t.titleMark}</mark>
			</h1>
			<p class="section-lead">{t.lead}</p>
			<div class="actions">
				<a class="button" href={getSectionPath(locale, 'katalog')}>{t.ctaCatalog}</a>
				<a class="button button--ghost" href={getCustomDesignPath(locale)}>{t.ctaCustom}</a>
			</div>
			<ul class="trust" aria-label={t.trustLabel}>
				{[t.trust1, t.trust2, t.trust3].map((item) => <li>{item}</li>)}
			</ul>
		</div>

		<div class="stage">
			<span class="blob blob--lilac" data-depth="-14" aria-hidden="true"></span>
			<span class="blob blob--mint" data-depth="18" aria-hidden="true"></span>
			<svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
				<circle cx="50" cy="50" r="48.5" fill="none" stroke="#c9391b" stroke-width="0.7" stroke-linecap="round" stroke-dasharray="2.2 3.6"></circle>
			</svg>
			<div class="sticker" data-depth="8">
				<Image id="stitch-img" src={heroLogo} alt={t.logoAlt} width={1024} loading="eager" fetchpriority="high" />
				<canvas id="stitch-canvas" role="img" aria-label={t.logoAlt} hidden></canvas>
			</div>
		</div>
	</div>
</section>

<script>
	import { buildStitchPlan } from '../lib/stitch';

	const hero = document.querySelector<HTMLElement>('#top');
	const layers = Array.from(document.querySelectorAll<HTMLElement>('#top [data-depth]'));
	const canMove = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function moveLayers(x: number, y: number) {
		for (const layer of layers) {
			const depth = Number(layer.dataset.depth);

			layer.style.setProperty('--tx', `${(x * depth).toFixed(1)}px`);
			layer.style.setProperty('--ty', `${(y * depth).toFixed(1)}px`);
		}
	}


	const STITCH_MS = 9000;
	const HOLD_MS = 3500;
	const FADE_MS = 700;
	const STITCH_BINS = 8;
	/** Point in a stitch, 0 to 1, where the needle has gone through the fabric. */
	const PIERCE_AT = 0.7;

	async function playStitching(wrap: HTMLElement, image: HTMLImageElement, canvas: HTMLCanvasElement) {
		await image.decode();

		const side = image.naturalHeight;
		const crop = document.createElement('canvas');

		crop.width = side;
		crop.height = side;

		const cropContext = crop.getContext('2d', { willReadFrequently: true });
		const context = canvas.getContext('2d');

		if (!cropContext || !context) {
			throw new Error('canvas unavailable');
		}

		// Same square crop the circular frame shows (object-fit: cover, centred).
		cropContext.drawImage(image, (image.naturalWidth - side) / 2, 0, side, side, 0, 0, side, side);

		const source = cropContext.getImageData(0, 0, side, side);
		const plan = buildStitchPlan(source.data, side, side);
		const layer = new ImageData(new Uint8ClampedArray(source.data), side, side);
		const layerCanvas = document.createElement('canvas');

		layerCanvas.width = side;
		layerCanvas.height = side;

		const layerContext = layerCanvas.getContext('2d');

		if (!layerContext) {
			throw new Error('canvas unavailable');
		}

		let red = 0;
		let green = 0;
		let blue = 0;
		let count = 0;

		for (let i = 0; i < plan.alpha.length; i++) {
			if (plan.alpha[i] === 0) {
				red += source.data[i * 4];
				green += source.data[i * 4 + 1];
				blue += source.data[i * 4 + 2];
				count++;
			}
		}

		const fabric = `rgb(${Math.round(red / count)} ${Math.round(green / count)} ${Math.round(blue / count)})`;

		canvas.width = side;
		canvas.height = side;
		wrap.style.backgroundColor = fabric;

		// The needle works in stitches: it hovers over the next spot, dips through the fabric,
		// and the thread appears where it went in.
		const stitches = Math.ceil(plan.bins / STITCH_BINS);
		const spotX = new Float32Array(stitches + 1).fill(side / 2);
		const spotY = new Float32Array(stitches + 1).fill(side / 2);
		const spotColour: string[] = new Array(stitches + 1).fill('#c9391b');
		const smooth = (from: number, to: number, value: number) => {
			const t = Math.min(1, Math.max(0, (value - from) / (to - from)));

			return t * t * (3 - 2 * t);
		};

		for (let n = 0; n < stitches; n++) {
			let sumX = 0;
			let sumY = 0;
			let added = 0;
			let pick = -1;

			for (let k = plan.binStart[n * STITCH_BINS]; k < plan.binStart[Math.min(plan.bins, (n + 1) * STITCH_BINS)]; k++) {
				const pixel = plan.order[k];

				sumX += pixel % side;
				sumY += Math.floor(pixel / side);
				added++;

				if (plan.alpha[pixel] === 255) {
					pick = pixel;
				}
			}

			// Stitch n lands at the middle of what it reveals; spot 0 is where the needle starts.
			spotX[n + 1] = added ? sumX / added : spotX[n];
			spotY[n + 1] = added ? sumY / added : spotY[n];
			spotColour[n + 1] =
				pick < 0
					? spotColour[n]
					: `rgb(${source.data[pick * 4]} ${source.data[pick * 4 + 1]} ${source.data[pick * 4 + 2]})`;
		}

		spotX[0] = spotX[1];
		spotY[0] = spotY[1];

		let revealed = 0;

		function reset() {
			for (let i = 3; i < layer.data.length; i += 4) {
				layer.data[i] = 0;
			}
			revealed = 0;
		}

		function drawNeedle(stitch: number, phase: number) {
			if (!context) {
				return;
			}

			const travel = smooth(0, PIERCE_AT, phase);
			const lift = side * 0.06 * smooth(0, 0.2, phase) * (1 - smooth(0.5, PIERCE_AT, phase));
			const x = spotX[stitch] + (spotX[stitch + 1] - spotX[stitch]) * travel;
			const y = spotY[stitch] + (spotY[stitch + 1] - spotY[stitch]) * travel - lift;
			const length = side * 0.13;
			const eyeX = x + length * 0.42;
			const eyeY = y - length * 0.91;

			// Thread runs from the eye back to the last stitch, so each stitch is pulled tight.
			context.lineCap = 'round';
			context.strokeStyle = spotColour[stitch + 1];
			context.lineWidth = side * 0.006;
			context.beginPath();
			context.moveTo(eyeX, eyeY);
			context.quadraticCurveTo(
				(eyeX + spotX[stitch]) / 2 + length * 0.25,
				(eyeY + spotY[stitch]) / 2 - length * 0.1,
				spotX[stitch],
				spotY[stitch],
			);
			context.stroke();

			context.shadowColor = 'rgb(33 26 56 / 0.35)';
			context.shadowBlur = side * 0.012;
			context.shadowOffsetY = side * 0.008 * (lift / (side * 0.06) + 0.3);
			context.strokeStyle = '#8c939c';
			context.lineWidth = side * 0.011;
			context.beginPath();
			context.moveTo(x, y);
			context.lineTo(eyeX, eyeY);
			context.stroke();
			context.shadowColor = 'transparent';
			context.strokeStyle = '#d6dbe0';
			context.lineWidth = side * 0.004;
			context.beginPath();
			context.moveTo(x + length * 0.03, y - length * 0.07);
			context.lineTo(eyeX - length * 0.02, eyeY + length * 0.12);
			context.stroke();
		}

		function draw(needle?: { stitch: number; phase: number }) {
			if (!context || !layerContext) {
				return;
			}

			layerContext.putImageData(layer, 0, 0);
			context.fillStyle = fabric;
			context.fillRect(0, 0, side, side);
			context.drawImage(layerCanvas, 0, 0);

			if (needle) {
				drawNeedle(needle.stitch, needle.phase);
			}
		}

		function advance(untilBin: number) {
			while (revealed < plan.bins && revealed < untilBin) {
				for (let k = plan.binStart[revealed]; k < plan.binStart[revealed + 1]; k++) {
					const pixel = plan.order[k];

					layer.data[pixel * 4 + 3] = plan.alpha[pixel];
				}
				revealed++;
			}
		}

		function cycle() {
			reset();
			canvas.style.opacity = '1';

			const started = performance.now();

			function frame(now: number) {
				const elapsed = now - started;

				if (elapsed < STITCH_MS) {
					const position = (elapsed / STITCH_MS) * stitches;
					const stitch = Math.floor(position);
					const phase = position - stitch;

					// The thread shows up once the needle has gone through.
					advance((stitch + (phase >= PIERCE_AT ? 1 : 0)) * STITCH_BINS);
					draw({ stitch, phase });
					requestAnimationFrame(frame);
					return;
				}

				advance(plan.bins);
				draw();
				setTimeout(() => {
					canvas.style.opacity = '0';
					setTimeout(cycle, FADE_MS);
				}, HOLD_MS);
			}

			requestAnimationFrame(frame);
		}

		draw();
		canvas.hidden = false;
		wrap.classList.add('is-live');
		cycle();
	}

	const stitchWrap = document.querySelector<HTMLElement>('#top .sticker');
	const stitchImage = document.querySelector<HTMLImageElement>('#stitch-img');
	const stitchCanvas = document.querySelector<HTMLCanvasElement>('#stitch-canvas');

	if (canMove && stitchWrap && stitchImage && stitchCanvas) {
		playStitching(stitchWrap, stitchImage, stitchCanvas).catch(() => stitchWrap.classList.add('is-static'));
	} else {
		stitchWrap?.classList.add('is-static');
	}

	if (canMove) {
		hero?.addEventListener('pointermove', (event) => {
			const bounds = hero.getBoundingClientRect();
			const x = (event.clientX - bounds.left) / bounds.width - 0.5;
			const y = (event.clientY - bounds.top) / bounds.height - 0.5;

			moveLayers(x * 2, y * 2);
		});
		hero?.addEventListener('pointerleave', () => moveLayers(0, 0));
	}
</script>

<style>
	.hero {
		padding-block: clamp(2.5rem, 7vw, 5rem) clamp(3rem, 8vw, 6rem);
	}

	.grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 3rem;
		align-items: center;
	}

	h1 {
		font-size: clamp(3rem, 9vw, 6.25rem);
		line-height: 1;
	}

	mark {
		background: linear-gradient(transparent 62%, var(--color-sun-soft) 62%);
		color: var(--color-thread-dark);
		font-style: italic;
	}

	.copy > * {
		animation: rise 0.7s var(--ease) both;
	}

	.copy > :nth-child(2) {
		animation-delay: 0.08s;
	}

	.copy > :nth-child(3) {
		animation-delay: 0.16s;
	}

	.copy > :nth-child(4) {
		animation-delay: 0.24s;
	}

	.copy > :nth-child(5) {
		animation-delay: 0.32s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: 1.75rem;
	}

	.trust {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.75rem;
		margin: 2.25rem 0 0;
		padding: 1.25rem 0 0;
		border-top: 1px solid var(--color-line);
		color: var(--color-ink-soft);
		font-size: 0.92rem;
		font-weight: 600;
		list-style: none;
	}

	.trust li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.trust li::before {
		display: grid;
		flex: none;
		place-items: center;
		width: 1.15rem;
		height: 1.15rem;
		border-radius: 50%;
		background: var(--color-thread);
		color: var(--color-paper);
		font-size: 0.7rem;
		line-height: 1;
		content: '✓';
	}

	.stage {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		width: 100%;
		max-width: 460px;
		margin-inline: auto;
	}

	.blob {
		translate: var(--tx, 0) var(--ty, 0);
		transition: translate 0.25s ease-out;
	}

	.blob {
		position: absolute;
		border-radius: 50%;
	}

	.blob--lilac {
		inset: 0 12% 12% 0;
		background: var(--color-lilac);
	}

	.blob--mint {
		inset: 22% 0 0 24%;
		background: var(--color-mint);
	}

	.ring {
		position: absolute;
		inset: 4%;
		width: 92%;
		height: 92%;
		animation: spin 60s linear infinite;
		pointer-events: none;
	}

	@keyframes spin {
		to {
			rotate: 360deg;
		}
	}

	.sticker {
		position: relative;
		width: 66%;
		aspect-ratio: 1;
		overflow: hidden;
		border: 6px solid var(--color-paper);
		border-radius: 50%;
		background: var(--color-cream);
		box-shadow: var(--shadow-lift);
		translate: var(--tx, 0) var(--ty, 0);
		transition: translate 0.25s ease-out;
	}

	.sticker :global(img),
	.sticker canvas {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.sticker canvas {
		position: absolute;
		inset: 0;
		transition: opacity 0.7s ease;
	}

	/* While the stitching animation owns the frame, hide the finished logo until it is ready. */
	:global(.js) .sticker:not(.is-static) :global(img) {
		opacity: 0;
	}
	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.stage {
			order: -1;
			max-width: 300px;
		}
	}
</style>
