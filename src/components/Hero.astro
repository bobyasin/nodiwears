---
import { Image } from 'astro:assets';
import heroLogo from '../assets/nodiwears.jpeg';
import type { Locale } from '../i18n/config';
import { getSectionPath } from '../i18n/paths';
import { ui } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].hero;
---

<section class="hero" id="top">
	<div class="container grid">
		<div class="copy">
			<h1>
				{t.titleLine}<br />
				<mark>{t.titleMark}</mark>
			</h1>
			<p class="section-lead">{t.lead}</p>
			<div class="actions">
				<a class="button" href={getSectionPath(locale, 'katalog')}>{t.ctaCatalog}</a>
				<a class="button button--ghost" href={getSectionPath(locale, 'iletisim')}>{t.ctaCustom}</a>
			</div>
		</div>

		<div class="stage">
			<span class="blob blob--lilac" data-depth="-14" aria-hidden="true"></span>
			<span class="blob blob--mint" data-depth="18" aria-hidden="true"></span>
			<svg class="squiggle" data-depth="26" viewBox="0 0 120 40" aria-hidden="true">
				<path d="M4 20c10-18 20-18 30 0s20 18 30 0 20-18 30 0 10 10 22 0" fill="none" stroke="#e5401c" stroke-width="5" stroke-linecap="round" stroke-dasharray="1 10"></path>
			</svg>
			<Image
				class="sticker"
				data-depth="8"
				src={heroLogo}
				alt={t.logoAlt}
				width={520}
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<script>
	const hero = document.querySelector<HTMLElement>('#top');
	const layers = Array.from(document.querySelectorAll<HTMLElement>('#top [data-depth]'));
	const canMove = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function moveLayers(x: number, y: number) {
		for (const layer of layers) {
			const depth = Number(layer.dataset.depth);

			layer.style.setProperty('--tx', `${(x * depth).toFixed(1)}px`);
			layer.style.setProperty('--ty', `${(y * depth).toFixed(1)}px`);
		}
	}

	if (canMove) {
		hero?.addEventListener('pointermove', (event) => {
			const bounds = hero.getBoundingClientRect();
			const x = (event.clientX - bounds.left) / bounds.width - 0.5;
			const y = (event.clientY - bounds.top) / bounds.height - 0.5;

			moveLayers(x * 2, y * 2);
		});
		hero?.addEventListener('pointerleave', () => moveLayers(0, 0));
	}
</script>

<style>
	.hero {
		padding-block: clamp(2.5rem, 7vw, 5rem) clamp(3rem, 8vw, 6rem);
	}

	.grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 2rem;
		align-items: center;
	}

	h1 {
		font-size: clamp(3.4rem, 11vw, 7.5rem);
	}

	mark {
		display: inline-block;
		padding: 0 0.2em;
		border: 3px solid var(--color-ink);
		border-radius: 0.3em;
		background: var(--color-pink);
		box-shadow: var(--shadow);
		color: var(--color-ink);
		transform: rotate(-2deg);
		transition: transform 0.2s;
	}

	mark:hover {
		transform: rotate(2deg) scale(1.04);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: 1.75rem;
	}

	.stage {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		width: 100%;
		max-width: 460px;
		margin-inline: auto;
	}

	.blob,
	.squiggle,
	.stage :global(.sticker) {
		translate: var(--tx, 0) var(--ty, 0);
		transition: translate 0.25s ease-out;
	}

	.blob {
		position: absolute;
		border: 3px solid var(--color-ink);
		border-radius: 50%;
	}

	.blob--lilac {
		inset: 0 12% 12% 0;
		background: var(--color-lilac);
	}

	.blob--mint {
		inset: 22% 0 0 24%;
		background: var(--color-mint);
	}

	.squiggle {
		position: absolute;
		right: -2%;
		bottom: 4%;
		width: 42%;
	}

	.stage :global(.sticker) {
		position: relative;
		width: 68%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border: 4px solid var(--color-ink);
		border-radius: 50%;
		background: var(--color-cream);
		box-shadow: 6px 6px 0 var(--color-ink);
		rotate: -6deg;
		transition: translate 0.25s ease-out, rotate 0.3s;
	}

	.stage :global(.sticker):hover {
		rotate: 6deg;
	}

	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
		}

		.stage {
			order: -1;
			max-width: 300px;
		}
	}
</style>
