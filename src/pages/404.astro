---
import Layout from '../layouts/Layout.astro';
---

<Layout locale="tr" title="404 | nodiwears" description="Sayfa bulunamadı / Page not found" noindex>
	<main id="main" class="not-found">
		<div class="container">
			<p class="code" aria-hidden="true">404</p>
			<h1>Sayfa bulunamadı<br /><span>Page not found</span></h1>
			<div class="actions">
				<a class="button" href="/">Ana sayfa</a>
				<a class="button button--ghost" href="/en/">Home</a>
			</div>
		</div>
	</main>
</Layout>

<style>
	.not-found {
		display: grid;
		min-height: 100vh;
		place-items: center;
		text-align: center;
	}

	.code {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(6rem, 25vw, 14rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--color-line-strong);
	}

	h1 {
		font-size: clamp(1.8rem, 5vw, 3rem);
	}

	h1 span {
		color: var(--color-ink-soft);
		font-size: 0.6em;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		justify-content: center;
		margin-top: 1.5rem;
	}
</style>
