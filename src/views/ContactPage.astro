---
import Contact from '../components/Contact.astro';
import CorporateTabs from '../components/CorporateTabs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../data/site';
import { getOtherLocale, type Locale } from '../i18n/config';
import { getPagePath } from '../i18n/paths';
import { ui } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].contactPage;
const alternatePath = getPagePath(getOtherLocale(locale), 'contact');
---

<Layout
	locale={locale}
	title={`${t.seoTitle} | ${siteConfig.name}`}
	description={t.description}
	alternatePath={alternatePath}
>
	<Header locale={locale} alternatePath={alternatePath} />
	<main id="main">
		<h1 class="visually-hidden">{t.seoTitle}</h1>
		<div class="container tabs">
			<CorporateTabs locale={locale} current="contact" />
		</div>
		<Contact locale={locale} />
	</main>
	<Footer locale={locale} />
</Layout>

<style>
	.tabs {
		padding-top: clamp(2rem, 5vw, 3.5rem);
	}
</style>
