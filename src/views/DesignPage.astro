---
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getRelatedDesigns, siteConfig } from '../data/site';
import { getOtherLocale, type Locale } from '../i18n/config';
import { getDesignPath, getHomePath, getSectionPath } from '../i18n/paths';
import { ui } from '../i18n/ui';
import { formatMessage } from '../lib/format';
import { buildBreadcrumbSchema } from '../lib/structured-data';
import Layout from '../layouts/Layout.astro';

interface Props {
	locale: Locale;
	id: string;
	title: string;
	collection: string;
}

const { locale, id, title, collection } = Astro.props;
const t = ui[locale].design;
const alternatePath = getDesignPath(getOtherLocale(locale), id);
const inquiry = formatMessage(t.inquiry, { collection, design: title });
const related = getRelatedDesigns(locale, id);
const absolute = (path: string) => new URL(path, siteConfig.url).href;
const structuredData = [
	buildBreadcrumbSchema([
		{ name: siteConfig.name, url: absolute(getHomePath(locale)) },
		{ name: ui[locale].catalog.title, url: absolute(getSectionPath(locale, 'katalog')) },
		{ name: title, url: absolute(getDesignPath(locale, id)) },
	]),
];
---

<Layout
	locale={locale}
	title={formatMessage(t.seoTitle, { title, name: siteConfig.name })}
	description={formatMessage(t.description, { collection, title })}
	alternatePath={alternatePath}
	structuredData={structuredData}
>
	<Header locale={locale} alternatePath={alternatePath} />
	<main id="main">
		<section class="section design">
			<div class="container">
				<a class="back" href={getSectionPath(locale, 'katalog')}>{t.back}</a>
				<p class="collection">{collection}</p>
				<h1>{title}</h1>
				<div class="preview" role="img" aria-label={formatMessage(t.previewAlt, { title })}>{t.previewSoon}</div>

				{
					related.length > 0 && (
						<nav class="related" aria-labelledby="related-heading">
							<h2 id="related-heading">{t.more}</h2>
							<ul>
								{related.map((design) => (
									<li>
										<a href={getDesignPath(locale, design.node.id)}>{design.title}</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
			</div>
		</section>
		<Contact locale={locale} defaultMessage={inquiry} />
	</main>
	<Footer locale={locale} />
</Layout>

<style>
	.back {
		display: inline-block;
		padding: 0.35rem 1rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 999px;
		background: var(--color-paper);
		font-weight: 600;
		text-decoration: none;
		transition: background 0.15s;
	}

	.back:hover {
		background: var(--color-lilac);
	}

	.collection {
		margin: 1.5rem 0 0.25rem;
		color: var(--color-ink-soft);
		font-weight: 600;
	}

	h1 {
		font-size: clamp(2.8rem, 9vw, 5.5rem);
	}

	.preview {
		position: relative;
		display: grid;
		place-items: center;
		max-width: 560px;
		aspect-ratio: 4 / 3;
		margin-top: 1.5rem;
		border: 1px solid var(--color-line-strong);
		border-radius: var(--radius);
		background: var(--color-lilac);
		box-shadow: var(--shadow);
		font-family: var(--font-display);
		font-size: 1.4rem;
		font-weight: 600;
	}

	.preview::before {
		position: absolute;
		inset: 10px;
		border: 1px dashed var(--color-line-strong);
		border-radius: calc(var(--radius) - 8px);
		content: '';
	}

	.related {
		margin-top: 2.5rem;
	}

	.related h2 {
		font-size: 1.3rem;
	}

	.related ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.related a {
		display: block;
		padding: 0.45rem 1.1rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 999px;
		background: var(--color-paper);
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.15s, background 0.15s;
	}

	.related a:hover {
		background: var(--color-lilac);
		transform: translateY(-2px);
	}
</style>
