---
import AccountForm from '../components/AccountForm.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../data/site';
import { getOtherLocale, type Locale } from '../i18n/config';
import { getPagePath } from '../i18n/paths';
import { ui } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';

interface Props {
	locale: Locale;
	kind: 'login' | 'register';
}

const { locale, kind } = Astro.props;
const t = ui[locale].account[kind];
const alternatePath = getPagePath(getOtherLocale(locale), kind);
---

<Layout locale={locale} title={`${t.seoTitle} | ${siteConfig.name}`} alternatePath={alternatePath} noindex>
	<Header locale={locale} alternatePath={alternatePath} />
	<main id="main">
		<AccountForm locale={locale} kind={kind} />
	</main>
	<Footer locale={locale} />
</Layout>
