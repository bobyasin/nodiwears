---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProfilePanel from '../components/ProfilePanel.astro';
import { siteConfig } from '../data/site';
import { getOtherLocale, type Locale } from '../i18n/config';
import { getPagePath } from '../i18n/paths';
import { ui } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].account.profile;
const alternatePath = getPagePath(getOtherLocale(locale), 'profile');
---

<Layout locale={locale} title={`${t.seoTitle} | ${siteConfig.name}`} alternatePath={alternatePath} noindex>
	<Header locale={locale} alternatePath={alternatePath} />
	<main id="main">
		<ProfilePanel locale={locale} />
	</main>
	<Footer locale={locale} />
</Layout>
