---
import Catalog from '../components/Catalog.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import { getOtherLocale, type Locale } from '../i18n/config';
import { siteConfig } from '../data/site';
import { getHomePath } from '../i18n/paths';
import { buildOrganizationSchema, buildWebSiteSchema } from '../lib/structured-data';
import Layout from '../layouts/Layout.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const alternatePath = getHomePath(getOtherLocale(locale));
const homeUrl = new URL(getHomePath(locale), siteConfig.url).href;
const structuredData = [
	buildOrganizationSchema({
		name: siteConfig.name,
		url: siteConfig.url,
		logoUrl: new URL('/apple-touch-icon.png', siteConfig.url).href,
		email: siteConfig.contactEmail,
	}),
	buildWebSiteSchema({ name: siteConfig.name, url: homeUrl, language: locale }),
];
---

<Layout locale={locale} alternatePath={alternatePath} structuredData={structuredData}>
	<Header locale={locale} alternatePath={alternatePath} />
	<main id="main">
		<Hero locale={locale} />
		<Catalog locale={locale} />
		<Process locale={locale} />
		<Contact locale={locale} />
	</main>
	<Footer locale={locale} />
</Layout>
