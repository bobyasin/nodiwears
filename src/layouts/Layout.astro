---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import ogImage from '../assets/nodiwears.jpeg';
import { siteConfig } from '../data/site';
import { getOtherLocale, type Locale } from '../i18n/config';
import { serializeJsonLd } from '../lib/structured-data';
import { ui } from '../i18n/ui';

interface Props {
	locale: Locale;
	title?: string;
	description?: string;
	alternatePath?: string;
	noindex?: boolean;
	structuredData?: readonly object[];
}

const { locale, title, description, alternatePath, noindex = false, structuredData = [] } = Astro.props;
const t = ui[locale];
const pageTitle = title ?? `${siteConfig.name} | ${t.meta.tagline}`;
const pageDescription = description ?? t.meta.description;
const ogLocale = locale === 'tr' ? 'tr_TR' : 'en_US';
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const imageUrl = new URL(ogImage.src, siteConfig.url).href;
const alternates = alternatePath
	? [
			{ hreflang: locale, href: canonicalUrl },
			{ hreflang: getOtherLocale(locale), href: new URL(alternatePath, siteConfig.url).href },
		]
	: [];
const defaultAlternate = alternates.find((alternate) => alternate.hreflang === 'tr');
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content="#fff8ee" />
		{noindex && <meta name="robots" content="noindex" />}
		{!noindex && <link rel="canonical" href={canonicalUrl} />}
		{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
		{defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content={String(ogImage.width)} />
		<meta property="og:image:height" content={String(ogImage.height)} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{structuredData.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
	</head>
	<body>
		<slot />
		<CookieBanner locale={locale} />
	</body>
</html>
